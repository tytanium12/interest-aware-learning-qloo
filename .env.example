# For Render environment configuration ONLY; NEVER place real secrets here.
# Render supplies RENDER_EXTERNAL_URL and PORT automatically.
HOSTED_LIVE_ENABLED=0
# Set to 1 on Render to open the demo without a login.
HOSTED_PUBLIC_DEMO=0
IAL_MODE=provider
IAL_TAVILY_ENRICHMENT=1
IAL_AUDITED_BUDGET=1
IAL_OPENAI_MAX_GENERATIONS=1
IAL_OPENAI_MAX_OUTPUT_TOKENS=6500
HOSTED_MAX_GENERATIONS=200
HOSTED_QUOTA_KEY=ial:hackathon:2026:live:v1
HOSTED_JUDGE_CODE=
HOSTED_COOKIE_SECRET=
QLOO_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# On Render, upload as a Secret File at /etc/secrets/tavily_api_key
TAVILY_API_KEY_FILE=/etc/secrets/tavily_api_key
